  "recipes": {
    "cuba-libre": {
      "es": {"description": "Prepara el cóctel directamente en un vaso Collins con hielo. Decora con una cuña de lima.", "preparationSteps": {"0": "Exprime la cantidad indicada de limón o lima y usa solo el zumo.", "1": "Vierte los ingredientes directamente en un vaso Collins con hielo.", "2": "Decora con una cuña de lima."}},
      "pt": {"description": "Monte o coquetel diretamente em um copo Collins com gelo. Decore com uma fatia de limão-taiti.", "preparationSteps": {"0": "Esprema a quantidade indicada de limão-siciliano ou limão-taiti e use apenas o suco.", "1": "Coloque os ingredientes diretamente em um copo Collins com gelo.", "2": "Decore com uma fatia de limão-taiti."}},
      "de": {"description": "Die Zutaten direkt in einem Collinsglas mit Eis mischen und mit einer Limettenspalte garnieren.", "preparationSteps": {"0": "Die angegebene Menge Zitrone oder Limette auspressen und nur den Saft verwenden.", "1": "Die Zutaten direkt in ein Collinsglas mit Eis geben.", "2": "Mit einer Limettenspalte garnieren."}},
      "fr": {"description": "Préparez le cocktail directement dans un verre Collins rempli de glaçons. Garnissez d'un quartier de citron vert.", "preparationSteps": {"0": "Pressez la quantité indiquée de citron jaune ou vert et n'utilisez que le jus.", "1": "Versez les ingrédients directement dans un verre Collins rempli de glaçons.", "2": "Garnissez d'un quartier de citron vert."}},
      "it": {"description": "Prepara il cocktail direttamente in un bicchiere Collins con ghiaccio. Guarnisci con uno spicchio di lime.", "preparationSteps": {"0": "Spremi la quantità indicata di limone o lime e usa solo il succo.", "1": "Versa gli ingredienti direttamente in un bicchiere Collins con ghiaccio.", "2": "Guarnisci con uno spicchio di lime."}},
      "tr": {"description": "Kokteyli buz dolu Collins bardağında hazırlayın. Bir dilim misket limonuyla süsleyin.", "preparationSteps": {"0": "Belirtilen miktarda limon veya misket limonunu sıkın ve yalnızca suyunu kullanın.", "1": "Malzemeleri doğrudan buz dolu bir Collins bardağına ekleyin.", "2": "Bir dilim misket limonuyla süsleyin."}},
      "zh": {"description": "将所有材料直接加入装满冰块的柯林斯杯，用一角青柠装饰。", "preparationSteps": {"0": "按所列用量挤出柠檬或青柠汁，只将果汁加入饮品。", "1": "将所有材料直接加入装满冰块的柯林斯杯。", "2": "用一角青柠装饰。"}},
      "ja": {"description": "氷を入れたコリンズグラスに材料を直接注ぎ、くし形に切ったライムを飾ります。", "preparationSteps": {"0": "指定量のレモンまたはライムを搾り、果汁だけを使います。", "1": "氷を入れたコリンズグラスに材料を直接注ぎます。", "2": "くし形に切ったライムを飾ります。"}},
      "ko": {"description": "얼음을 채운 콜린스 잔에 재료를 바로 넣고 라임 조각으로 장식합니다.", "preparationSteps": {"0": "표시된 양의 레몬이나 라임을 짜서 즙만 사용합니다.", "1": "얼음을 채운 콜린스 잔에 재료를 바로 넣습니다.", "2": "라임 조각으로 장식합니다."}},
      "hi": {"description": "बर्फ़ भरे कॉलिन्स गिलास में सीधे कॉकटेल बनाएँ। हरे नींबू की फाँक से सजाएँ।", "preparationSteps": {"0": "बताई गई मात्रा में पीला या हरा नींबू निचोड़ें और पेय में केवल उसका रस डालें।", "1": "सामग्री सीधे बर्फ़ भरे कॉलिन्स गिलास में डालें।", "2": "हरे नींबू की फाँक से सजाएँ।"}},
      "ar": {"description": "حضّر الكوكتيل مباشرة في كأس كولينز مملوء بالثلج وزيّنه بقطعة ليمون أخضر.", "preparationSteps": {"0": "اعصر الكمية المذكورة من الليمون الأصفر أو الأخضر واستخدم العصير فقط.", "1": "اسكب المكونات مباشرة في كأس كولينز مملوء بالثلج.", "2": "زيّن الكأس بقطعة ليمون أخضر."}}
